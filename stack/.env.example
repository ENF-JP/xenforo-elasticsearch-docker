# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. The setup scripts do this for you and generate
# the secrets — `xf setup` on Linux/macOS, `.\xf.ps1 setup` on Windows.
#
# NEVER COMMIT `.env`. It is listed in .gitignore. The values below are
# placeholders, not defaults: the stack refuses to start if the password
# variables are still empty.
# ---------------------------------------------------------------------------

# ---- Secrets (generate; do not type something memorable) -------------------
# Leave these empty and let the setup script fill them. To generate one by hand
# (32 alphanumeric characters from a cryptographic source):
#   Linux/macOS   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo
#   Windows       $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { [char](((48..57)+(65..90)+(97..122))[$_ % 62]) })
# Do NOT use Get-Random on Windows: it is not a cryptographic generator.
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# XenForo admin account created during install.
XF_ADMIN_USER=admin
XF_ADMIN_PASSWORD=
# Board and admin email used by the installer. A dev box sends no mail, so a
# reserved example domain is fine.
XF_ADMIN_EMAIL=admin@example.com
XF_BOARD_TITLE=XenForo Dev

# ---- Where your licensed XenForo files come from ---------------------------
# XenForo is commercial software and is NOT distributed with this repo. Point
# this at your own copy — either an unpacked directory containing `src/` and
# `cmd.php`, or a XenForo release zip.
#
#   Linux/macOS   /home/you/xenforo_2.3.x/upload
#   Windows       G:\sources\xenforo_2.3.x\upload
#
# The setup script copies it to XF_WEBROOT once and never touches the source
# again, so your reference copy stays pristine.
XF_SOURCE=

# Working copy the container serves. Relative paths are resolved from stack/.
XF_WEBROOT=./webroot

# ---- Ports (host side; always loopback-bound in docker-compose.yml) --------
HTTP_PORT=80
MAILPIT_PORT=8025

# ---- Versions --------------------------------------------------------------
# Each is pinned on purpose. See docs/upgrading.md before changing one on a
# stack that already has data - some changes are one-way.
PHP_VERSION=8.4
ES_VERSION=8.19.25
MARIADB_VERSION=11.4
MAILPIT_VERSION=v1.33.1
PHP_TIMEZONE=UTC

# ---- Resources -------------------------------------------------------------
# ES_HEAP must be <= half of ES_MEM_LIMIT. Raising the heap without raising the
# limit gets the JVM OOM-killed under load.
ES_HEAP=1g
ES_MEM_LIMIT=2g
MARIADB_BUFFER_POOL=512M

# ---- Naming ----------------------------------------------------------------
# To run a second stack beside this one, give it its own checkout and set BOTH
# of these (plus a different HTTP_PORT). COMPOSE_PREFIX only renames the
# containers; COMPOSE_PROJECT_NAME keeps the two stacks' volumes apart. Do not
# change COMPOSE_PROJECT_NAME on a stack that already has data.
COMPOSE_PREFIX=xf
# COMPOSE_PROJECT_NAME=xenforo-dev
MARIADB_DATABASE=xenforo
MARIADB_USER=xenforo
