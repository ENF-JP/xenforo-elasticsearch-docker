# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. The setup scripts do this for you and generate
# the secrets — `xf setup` on Linux/macOS, `.\xf.ps1 setup` on Windows.
#
# NEVER COMMIT `.env`. It is listed in .gitignore. The values below are
# placeholders, not defaults: the stack refuses to start if the password
# variables are still empty.
# ---------------------------------------------------------------------------

# ---- Secrets (generate; do not type something memorable) -------------------
# Generate 32-char values:
#   Linux/macOS   openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
#   Windows       -join ((48..57+65..90+97..122) | Get-Random -Count 32 | % {[char]$_})
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# XenForo admin account created during install.
XF_ADMIN_USER=admin
XF_ADMIN_PASSWORD=

# ---- Where your licensed XenForo files come from ---------------------------
# XenForo is commercial software and is NOT distributed with this repo. Point
# this at your own copy — either an unpacked directory containing `src/` and
# `cmd.php`, or the upload/ directory of a XenForo release zip.
#
#   Linux/macOS   /home/you/xenforo_2.3.12/upload
#   Windows       G:\sources\xenforo_2.3.12\upload
#
# The setup script copies it to XF_WEBROOT once and never touches the source
# again, so your reference copy stays pristine.
XF_SOURCE=

# Working copy the container serves. Relative paths are resolved from stack/.
XF_WEBROOT=./webroot

# ---- Ports (host side; always loopback-bound in docker-compose.yml) --------
HTTP_PORT=80
MAILPIT_PORT=8025

# ---- Versions --------------------------------------------------------------
PHP_VERSION=8.3
ES_VERSION=8.15.0

# ---- Resources -------------------------------------------------------------
# ES_HEAP must be <= half of ES_MEM_LIMIT. Raising the heap without raising the
# limit gets the JVM OOM-killed under load.
ES_HEAP=1g
ES_MEM_LIMIT=2g
MARIADB_BUFFER_POOL=512M

# ---- Naming ----------------------------------------------------------------
# Container name prefix. Change it if you run more than one stack on the same
# machine, so container names don't collide.
COMPOSE_PREFIX=xf
MARIADB_DATABASE=xenforo
MARIADB_USER=xenforo
